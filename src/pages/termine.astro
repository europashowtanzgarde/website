---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import EventItem from '../components/EventItem.astro';
import { getUpcomingEvents, getPastEvents } from '../lib/collections';
import { isoDate } from '../lib/date';
import { site } from '../lib/settings';

const upcoming = await getUpcomingEvents();
const past = await getPastEvents(8);
const eventsLd = upcoming.map((e) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: e.data.title,
  startDate: e.data.time ? `${isoDate(e.data.date)}T${e.data.time}` : isoDate(e.data.date),
  ...(e.data.endDate ? { endDate: isoDate(e.data.endDate) } : {}),
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: e.data.location },
  organizer: { '@type': 'Organization', name: site.name },
  ...(e.data.description ? { description: e.data.description } : {}),
}));
---

<BaseLayout title="Termine und Auftritte" description="Kommende Auftritte, Feste und Veranstaltungen der Europa-Show-Tanzgarde aus Wassertrüdingen.">
  <Fragment slot="head">
    {eventsLd.map((ld) => <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />)}
  </Fragment>

  <PageIntro title="Termine und Auftritte" flush tightTop compactTitle />

  <section class="section section--tight upcoming-events">
    <div class="wrap events-page">
      {
        upcoming.length === 0 ? (
          <p class="empty-state">Aktuell sind keine öffentlichen Termine eingetragen. Folgt uns auf Social Media, um nichts zu verpassen.</p>
        ) : (
          <div class="events-page__list">{upcoming.map((event) => <EventItem event={event} showDescription variant="listing" />)}</div>
        )
      }
    </div>
  </section>

  {
    past.length > 0 && (
      <section class="section section--tight events-past">
        <div class="wrap events-page">
          <h2>Rückblick</h2>
          <p class="events-past__intro">Vergangene Auftritte und Veranstaltungen.</p>
          <div class="events-page__list">{past.map((event) => <EventItem event={event} past variant="listing" />)}</div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .events-page {
    display: grid;
    gap: var(--space-5);
  }

  .section.upcoming-events {
    padding-top: var(--space-4);
    background: var(--bg);
    border-top: 0;
  }

  .events-page__list {
    display: grid;
    gap: 0;
    justify-self: start;
    width: 100%;
    max-width: 68rem;
  }

  .events-page h2 {
    font-size: var(--step-2);
  }

  .events-past {
    background: var(--surface-soft);
    border-block: 1px solid var(--hairline);
  }

  .events-past__intro {
    color: var(--text-muted);
  }

  :global(.page-intro h1) {
    max-width: none;
    font-size: clamp(2rem, 2rem + 3vw, 5.1rem);
    white-space: nowrap;
  }

  :global(.page-intro__inner) {
    grid-template-columns: minmax(0, 1fr);
  }
</style>
