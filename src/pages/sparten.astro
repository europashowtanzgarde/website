---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import GroupCard from '../components/GroupCard.astro';
import { getGroups } from '../lib/collections';

const groups = await getGroups();
---

<BaseLayout title="Unsere Sparten" description="Kindergarde, Jugend-Tanzgarde und die Aktiven: die drei Garden der Europa-Show-Tanzgarde aus Wassertrüdingen.">
  <PageIntro title="Unsere Sparten" flush tightTop />

  <section class="section section--tight groups-section">
    <div class="wrap groups-stack">
      {groups.map((group) => <GroupCard group={group} variant="detail" />)}
      <div class="interest">
        <h2>Interesse geweckt?</h2>
        <p>Du hast Lust auf Tanzen oder möchtest mehr über die Europa-Show-Tanzgarde erfahren?</p>
        <p>Komm einfach bei einem Training vorbei oder nimm Kontakt mit uns auf. Wir freuen uns auf dich!</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .groups-stack {
    display: grid;
  }

  .groups-section {
    padding-top: var(--space-3);
    padding-bottom: var(--space-4);
  }

  .groups-stack :global(.group-profile:first-child) {
    padding-top: var(--space-2);
    border-top: 0;
  }

  .groups-stack :global(.group-profile__body) {
    padding-block: var(--space-4) var(--space-5);
  }

  @media (min-width: 720px) {
    .groups-stack :global(.group-profile.is-detail) {
      padding-block: clamp(1.25rem, 2.5vw, 2.25rem);
    }
  }

  .interest {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--hairline-strong);
  }

  .interest h2 {
    font-size: var(--step-3);
  }

  .interest p {
    max-width: 52rem;
    margin-top: var(--space-3);
    color: var(--text-muted);
  }

  :global(.site-footer) {
    margin-top: var(--space-3);
  }

</style>
