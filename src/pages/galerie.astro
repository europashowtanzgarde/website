---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { Image } from 'astro:assets';
import { getGalleryBereiche } from '../lib/collections';

/*
  Die Bereiche und ihre Bilder kommen aus `src/content/gallery/` und sind damit
  redaktionell pflegbar. Zuvor wurden sie aus den Dateinamen im Ordner
  `src/assets/gallery/` abgeleitet – die Reihenfolge hing an `localeCompare`,
  die Zuordnung an Präfixen wie „Kindergarde …". Beides ließ sich über eine
  Oberfläche nicht bedienen.

  Unverändert bleibt die Darstellung: Das Rasterlayout verteilt die Bilder nach
  ihrem Seitenverhältnis (`--image-ratio`), das aus den Maßen der optimierten
  Bilder stammt.
*/
const sections = await getGalleryBereiche();
---

<BaseLayout title="Galerie" description="Bilder aus Training, Auftritten und dem Vereinsleben der Europa-Show-Tanzgarde.">
  <PageIntro title="Galerie" flush tightTop compactTitle />

  <section class="section section--tight gallery-section">
    <div class="wrap gallery-page">
      {sections.map((section) => (
        <section class="gallery-group" aria-labelledby={`gallery-${section.title.toLowerCase().replace(/[^a-zäöü]+/g, '-')}`}>
          <header class="gallery-group__head">
            <h2 id={`gallery-${section.title.toLowerCase().replace(/[^a-zäöü]+/g, '-')}`}>{section.title}</h2>
          </header>
          <div class="gallery-grid">
            {section.images.map((image) => (
              <figure
                class:list={['gallery-card', { 'is-youth-crop': image.crop169 }]}
                style={`--image-ratio: ${image.crop169 ? 16 / 9 : image.image.width / image.image.height}`}
              >
                <Image
                  src={image.image}
                  alt={image.alt}
                  width={720}
                  quality={78}
                  loading="lazy"
                />
              </figure>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-section {
    padding-top: var(--space-3);
  }

  .gallery-group + .gallery-group {
    margin-top: var(--section-space);
    padding-top: var(--space-7);
    border-top: 1px solid var(--hairline-strong);
  }

  .gallery-group__head {
    margin-bottom: var(--space-6);
  }

  .gallery-group__head h2 {
    max-width: none;
    font-size: var(--step-3);
    white-space: nowrap;
  }

  .gallery-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .gallery-card {
    flex-grow: var(--image-ratio);
    flex-basis: calc(var(--image-ratio) * 13rem);
    min-width: 0;
    max-width: 38rem;
  }

  .gallery-card :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-m);
    background: var(--surface-soft-blue);
  }

  .gallery-card.is-youth-crop :global(img) {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center 44%;
  }

  @media (max-width: 520px) {
    .gallery-card {
      flex-basis: 100%;
      max-width: none;
    }
  }

</style>
