---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site } from '../lib/settings';

// Anschrift, Telefonnummern, Einleitung und Bild standen früher fest im
// Markup – bei einem Vorstandswechsel war dafür eine Code-Änderung nötig.
const { kontakt } = site;
---

<BaseLayout title="Kontakt" description="So erreichst du die Europa-Show-Tanzgarde aus Wassertrüdingen – per E-Mail oder über unsere Social-Media-Kanäle.">
  <PageIntro title="Kontakt" flush tightTop compactTitle />

  <section class="contact-stage" aria-label="Direkter Kontakt">
    <div class="wrap contact-stage__inner">
      <div class="contact-stage__copy">
        {kontakt.intro.map((absatz) => <p>{absatz}</p>)}

        <div class="contact-details">
          {kontakt.adresse.length > 0 && (
            <section>
              <h2>Adresse</h2>
              <address>
                {kontakt.adresse.map((zeile, i) => (
                  <Fragment>{i > 0 && <br />}{zeile}</Fragment>
                ))}
              </address>
            </section>
          )}
          <section>
            <h2>E-Mail</h2>
            <p>{site.email}</p>
          </section>
          {kontakt.telefon.length > 0 && (
            <section>
              <h2>Telefon</h2>
              <p>
                {kontakt.telefon.map((eintrag, i) => (
                  <Fragment>{i > 0 && <br />}{eintrag.name}: {eintrag.nummer}</Fragment>
                ))}
              </p>
            </section>
          )}
          {site.social.instagram && (
            <section>
              <h2>Instagram</h2>
              <a class="contact-details__instagram" href={site.social.instagram} target="_blank" rel="noopener">
                <span class="contact-details__instagram-label"><SocialIcon platform="instagram" />Profil besuchen</span>
                <span class="contact-details__instagram-arrow" aria-hidden="true">→</span>
              </a>
            </section>
          )}
        </div>

      </div>

      {kontakt.bild && (
        <figure class="contact-stage__visual">
          {/*
            Ohne feste width/height: Die Maße passten nur zum ursprünglichen
            Bild. Das Layout hängt ohnehin am 3:4-Rahmen im CSS.
          */}
          <img
            src={kontakt.bild}
            alt={kontakt.bildAlt}
            loading="eager"
            decoding="async"
          />
        </figure>
      )}

    </div>
  </section>

</BaseLayout>

<style>
  .contact-stage {
    padding-block: var(--space-1) var(--space-6);
    color: var(--text);
    background: transparent;
  }

  .contact-stage__inner {
    display: grid;
    gap: var(--space-7) clamp(2.5rem, 8vw, 8rem);
    align-items: center;
  }

  @media (min-width: 820px) {
    .contact-stage__inner {
      grid-template-columns: minmax(0, 1.3fr) minmax(15rem, 0.7fr);
    }
  }

  .contact-stage__copy {
    min-width: 0;
  }

  .contact-stage h2 {
    max-width: 12ch;
    font-size: var(--step-3);
    color: var(--text);
  }

  .contact-stage__copy > p {
    max-width: 38rem;
    margin-top: var(--space-4);
    font-size: var(--step-0);
    color: var(--text-muted);
  }

  .contact-details {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .contact-details section {
    padding-top: var(--space-3);
    border-top: 1px solid var(--hairline-strong);
  }

  .contact-details h2 {
    max-width: none;
    font-size: var(--step-1);
    color: var(--blue-700);
  }

  .contact-details p,
  .contact-details address {
    margin-top: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-style: normal;
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .contact-details__instagram {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding-block: var(--space-3);
    font-weight: 700;
    color: var(--blue-700);
    border-bottom: 1px solid var(--hairline-strong);
    text-decoration: none;
  }

  .contact-details__instagram:hover {
    color: var(--red-600);
  }

  .contact-details__instagram-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .contact-details__instagram-arrow {
    font-size: var(--step-1);
    transition: transform var(--transition-fast);
  }

  .contact-details__instagram:hover .contact-details__instagram-arrow {
    transform: translateX(0.3rem);
  }

  .contact-stage__visual {
    width: min(100%, 20rem);
    aspect-ratio: 3 / 4;
    margin: 0;
    justify-self: end;
    overflow: hidden;
  }

  .contact-stage__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

</style>
