---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site } from '../lib/settings';

---

<BaseLayout title="Kontakt" description="So erreichst du die Europa-Show-Tanzgarde aus Wassertrüdingen – per E-Mail oder über unsere Social-Media-Kanäle.">
  <PageIntro title="Kontakt" flush tightTop />

  <section class="contact-stage" aria-label="Direkter Kontakt">
    <div class="wrap contact-stage__inner">
      <div class="contact-stage__copy">
        <p>Du möchtest mehr über die Europa-Show-Tanzgarde erfahren, bei uns mittanzen oder uns für eure Veranstaltung buchen?</p>
        <p>Komm bei einem Training vorbei, kontaktiere uns direkt über unsere Website, per Mail oder per Telefon. Wir freuen uns auf dich!</p>

        <div class="contact-details">
          <section>
            <h2>Adresse</h2>
            <address>
              Europa-Show-Tanzgarde Wassertrüdingen e.V.<br />
              Neue Schulgasse 1<br />
              91717 Wassertrüdingen
            </address>
          </section>
          <section>
            <h2>E-Mail</h2>
            <p>info@europashowtanzgarde.de</p>
          </section>
          <section>
            <h2>Telefon</h2>
            <p>Luisa Geier: +49 151 23461278<br />Pauline Höver: +49 162 1807530</p>
          </section>
          {site.social.instagram && (
            <section>
              <h2>Instagram</h2>
              <a class="contact-details__instagram" href={site.social.instagram} target="_blank" rel="noopener">
                <span class="contact-details__instagram-label"><SocialIcon platform="instagram" />Profil besuchen</span>
                <span class="contact-details__instagram-arrow" aria-hidden="true">→</span>
              </a>
            </section>
          )}
        </div>

      </div>

      <figure class="contact-stage__visual">
        <img
          src="/uploads/pauline-und-luisa.png"
          alt="Zwei Vorstandsmitglieder der Europa-Show-Tanzgarde vor dem Kulturtreff in Wassertrüdingen."
          width="721"
          height="977"
          loading="eager"
          decoding="async"
        />
      </figure>

    </div>
  </section>

</BaseLayout>

<style>
  .contact-stage {
    padding-block: var(--space-1) var(--space-6);
    color: var(--text);
    background: transparent;
  }

  .contact-stage__inner {
    display: grid;
    gap: var(--space-7) clamp(2.5rem, 8vw, 8rem);
    align-items: center;
  }

  @media (min-width: 820px) {
    .contact-stage__inner {
      grid-template-columns: minmax(0, 1.3fr) minmax(15rem, 0.7fr);
    }
  }

  .contact-stage__copy {
    min-width: 0;
  }

  .contact-stage h2 {
    max-width: 12ch;
    font-size: var(--step-3);
    color: var(--text);
  }

  .contact-stage__copy > p {
    max-width: 38rem;
    margin-top: var(--space-4);
    font-size: var(--step-0);
    color: var(--text-muted);
  }

  .contact-details {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .contact-details section {
    padding-top: var(--space-3);
    border-top: 1px solid var(--hairline-strong);
  }

  .contact-details h2 {
    max-width: none;
    font-size: var(--step-1);
    color: var(--blue-700);
  }

  .contact-details p,
  .contact-details address {
    margin-top: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-style: normal;
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .contact-details__instagram {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding-block: var(--space-3);
    font-weight: 700;
    color: var(--blue-700);
    border-bottom: 1px solid var(--hairline-strong);
    text-decoration: none;
  }

  .contact-details__instagram:hover {
    color: var(--red-600);
  }

  .contact-details__instagram-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .contact-details__instagram-arrow {
    font-size: var(--step-1);
    transition: transform var(--transition-fast);
  }

  .contact-details__instagram:hover .contact-details__instagram-arrow {
    transform: translateX(0.3rem);
  }

  .contact-stage__visual {
    width: min(100%, 20rem);
    aspect-ratio: 3 / 4;
    margin: 0;
    justify-self: end;
    overflow: hidden;
  }

  .contact-stage__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

</style>
