---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PostCard from '../components/PostCard.astro';
import EventItem from '../components/EventItem.astro';
import GroupCard from '../components/GroupCard.astro';
import { Image } from 'astro:assets';
import { getPublishedPosts, getUpcomingEvents, getGroups, getAnlass } from '../lib/collections';
import { homepage } from '../lib/settings';

const posts = (await getPublishedPosts()).slice(0, 3);
const events = await getUpcomingEvents(4);
const groups = await getGroups();
const { notice } = homepage;
// Blockt für besondere Anlässe (Jubiläum o. Ä.) – über /admin ein- und
// ausschaltbar, statt wie zuvor fest im Markup zu stehen.
const anlass = await getAnlass();
---

<BaseLayout>
  <h1 class="visually-hidden">Europa-Show-Tanzgarde e.V. – Showtanz und Gardetanz aus Wassertrüdingen</h1>
  <Hero />

  {
    notice.enabled && notice.text && (
      <aside class="notice" aria-label="Aktueller Hinweis">
        <div class="wrap notice__inner">
          <p>{notice.text}</p>
          {notice.link && notice.linkLabel && <a class="arrow-link" href={notice.link}>{notice.linkLabel}</a>}
        </div>
      </aside>
    )
  }

  {
    events.length > 0 && (
      <section class="section home-program">
        <div class="wrap">
          <SectionHeading title="Kommende Termine" />
          <div class="home-program__scroll" tabindex="0" aria-label="Die nächsten vier Termine, horizontal scrollbar">
            <div class="home-program__list">
              {events.map((event) => <EventItem event={event} variant="timeline" />)}
            </div>
          </div>
          <a class="arrow-link home-more" href="/termine">Alle Termine ansehen <span aria-hidden="true">→</span></a>
        </div>
      </section>
    )
  }

  {
    anlass?.enabled && (
      <section class="section rule-section home-special">
        <div class="wrap">
          <article class="home-special__card">
            {anlass.image && (
              <div class="home-special__media">
                <Image
                  src={anlass.image}
                  alt={anlass.imageAlt}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 860px) 38vw, 100vw"
                  loading="lazy"
                />
              </div>
            )}
            <div class="home-special__copy">
              {anlass.eyebrow && <p class="home-special__eyebrow">{anlass.eyebrow}</p>}
              <h2>{anlass.title}</h2>
              {anlass.text && <p>{anlass.text}</p>}
              {anlass.facts.length > 0 && (
                <dl class="home-special__facts">
                  {anlass.facts.map((fact) => (
                    <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
                  ))}
                </dl>
              )}
              {anlass.footnote && <p class="home-special__thanks">{anlass.footnote}</p>}
            </div>
          </article>
        </div>
      </section>
    )
  }

  <section class="section rule-section">
    <div class="wrap">
      <SectionHeading title="Unsere Sparten" />
      <div class="groups-index">
        {groups.map((group) => <GroupCard group={group} variant="summary" />)}
      </div>
      <a class="arrow-link home-more" href="/sparten">Sparten kennenlernen <span aria-hidden="true">→</span></a>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section rule-section">
        <div class="wrap">
          <SectionHeading title="Aktuelles" />
          <div class="posts-list">
            {posts.map((post) => <PostCard post={post} />)}
          </div>
          <a class="arrow-link home-more" href="/aktuelles">Alle Beiträge lesen <span aria-hidden="true">→</span></a>
        </div>
      </section>
    )
  }

  <section class="section rule-section home-features" aria-label="Mitmachen und Auftritte buchen">
    <div class="wrap home-features__grid">
      <article class="home-feature">
        <div class="home-feature__copy">
          <h2>Lust aufs Tanzen? Komm vorbei!</h2>
          <p>Ob Kindergarde, Jugendgarde oder Große Garde – bei uns ist Platz für alle, die gerne tanzen und Teil unserer Gemeinschaft werden möchten. Entdecke unsere Sparten und komm zu uns!</p>
          <a class="arrow-link" href="/sparten">Sparten kennenlernen <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <article class="home-feature">
        <div class="home-feature__copy">
          <h2>Ihr sucht noch ein Highlight? Dann bucht uns!</h2>
          <p>Ob Firmenfeier, private Feier, Vereinsfest oder Veranstaltung – unsere Sparten sorgen mit mitreißenden Choreografien und jeder Menge Energie für besondere Momente.</p>
          <a class="arrow-link" href="/kontakt">Auftritt anfragen <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </section>

</BaseLayout>

<style>
  /* Die Startseite bleibt bewusst kompakter als die ausführlichen Unterseiten. */
  .section {
    padding-block: clamp(2.5rem, 4.5vw, 4rem);
  }

  .section :global(.section-heading) {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .notice {
    color: var(--text);
    background: color-mix(in srgb, var(--red-600) 7%, white);
    border-bottom: 1px solid color-mix(in srgb, var(--red-600) 30%, white);
  }

  .notice__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
  }

  .notice__inner::before {
    content: '';
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--red-600);
  }

  .home-program__scroll {
    max-width: 68rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-color: var(--blue-300) transparent;
  }

  .home-program__list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(12.5rem, 1fr));
    min-width: 52rem;
    padding-block: var(--space-2);
    background: transparent;
  }

  .home-program__list::before {
    position: absolute;
    top: 5.25rem;
    right: 12.5%;
    left: 12.5%;
    height: 1px;
    content: '';
    background: var(--blue-700);
  }

  .home-program {
    padding-bottom: clamp(2.5rem, 4.5vw, 4rem);
  }

  .home-more {
    margin-top: var(--space-2);
  }

  .home-special__card {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    width: 100%;
  }

  .home-special__media {
    overflow: hidden;
    width: min(100%, 16rem);
    background: var(--blue-950);
  }

  .home-special__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .home-special__copy {
    width: 100%;
  }

  .home-special__eyebrow {
    margin-bottom: var(--space-2);
    color: var(--red-600);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-special__copy h2 {
    max-width: none;
    font-size: clamp(1.75rem, 4.6vw, var(--step-4));
    /*
      Früher `white-space: nowrap` – bei einem längeren Titel als dem
      Jubiläums-Titel wäre die Überschrift aus dem Layout gelaufen. Kurze Titel
      bleiben durch geschützte Leerzeichen im Text weiterhin einzeilig.
    */
    text-wrap: balance;
  }

  .home-special__copy > p:not(.home-special__eyebrow) {
    margin-top: var(--space-3);
    color: var(--text-muted);
  }

  .home-special__facts {
    display: grid;
    /*
      Früher fest `repeat(3, …)`. Bei drei Eckdaten pixelgleich, verträgt aber
      auch zwei oder vier – und bricht auf schmalen Displays um, statt die
      Spalten unlesbar schmal zu quetschen.
    */
    grid-template-columns: repeat(auto-fit, minmax(min(7rem, 100%), 1fr));
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .home-special__facts div {
    padding-top: var(--space-2);
    border-top: 1px solid var(--blue-300);
  }

  .home-special__facts dt {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .home-special__facts dd {
    margin: 0.2rem 0 0;
    font-weight: 700;
  }

  .home-special__thanks {
    font-weight: 700;
  }

  @media (min-width: 680px) {
    .home-special__card {
      grid-template-columns: minmax(13rem, 16rem) minmax(20rem, 1fr);
    }
  }

  .groups-index {
    display: grid;
    gap: var(--space-6);
  }

  .groups-index :global(.group-profile.is-summary) {
    margin-top: 0;
  }

  @media (min-width: 680px) and (max-width: 859px) {
    .groups-index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  @media (min-width: 860px) {
    .groups-index {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .posts-list {
    max-width: 62rem;
  }

  .posts-list :global(.post-teaser) {
    padding-block: var(--space-5);
  }

  .posts-list :global(.post-teaser:first-child) {
    padding-top: var(--space-2);
    border-top: 0;
  }

  .posts-list :global(.post-teaser__more) {
    margin-top: var(--space-2);
  }

  .home-features__grid {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .home-features {
    padding-bottom: clamp(0.625rem, 1.125vw, 1rem);
  }

  .home-feature {
    min-width: 0;
  }

  .home-feature__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    width: 100%;
  }

  .home-feature h2 {
    max-width: none;
    font-size: var(--step-3);
  }

  .home-feature__copy > p {
    max-width: none;
    margin-top: var(--space-2);
    color: var(--text-muted);
  }

  .home-feature .arrow-link {
    margin-top: 0;
  }

  :global(.site-footer) {
    margin-top: 0;
  }

</style>
