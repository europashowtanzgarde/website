---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CmsImage from '../../components/CmsImage.astro';
import ImageCarousel from '../../components/ImageCarousel.astro';
import { getPublishedPosts } from '../../lib/collections';
import { formatDate, isoDate } from '../../lib/date';
import { bildProps } from '../../lib/bild';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const {
  title, date, dateLabel, hideDate, description, lead, leadImContent,
  cover, coverAlt, coverFocusY, coverZoom, coverOffsetX, coverFit, gallery,
} = post.data;

// Titelbild und Beitragsbilder mit ihrem jeweils redaktionell gepflegten
// Bildausschnitt (früher pro Dateiname fest im Code hinterlegt).
const coverDarstellung = bildProps({
  focusY: coverFocusY, zoom: coverZoom, offsetX: coverOffsetX, fit: coverFit,
});
const carouselImages = cover && gallery.length > 0
  ? [
      { image: cover, alt: coverAlt, ...coverDarstellung },
      ...gallery.map(({ image, alt, caption, focusY, zoom, offsetX, fit }) => ({
        image, alt, caption, ...bildProps({ focusY, zoom, offsetX, fit }),
      })),
    ]
  : [];
const { Content } = await render(post);
---

<BaseLayout title={title} description={description} ogImage={cover ?? '/og-default.png'} article>
  <article class:list={['post', `post--${post.id}`, { 'has-lead-im-content': Boolean(lead && leadImContent) }]}>
    <div class="wrap post__inner">
      <header class="post__head">
        <div class="post__title-block">
          {!hideDate && <time datetime={isoDate(date)}>{dateLabel ?? formatDate(date)}</time>}
          <h1>{title}</h1>
        </div>
      </header>

      {lead && !leadImContent && <p class="post__lead">{lead}</p>}

      {cover && (
        <div class="post__cover">
          {carouselImages.length > 0
            ? <ImageCarousel images={carouselImages} label={`Bilder zum Beitrag ${title}`} />
            : <CmsImage
                src={cover}
                alt={coverAlt}
                ratio="4 / 3"
                loading="eager"
                position={coverDarstellung.position}
                scale={coverDarstellung.scale}
                offsetX={coverDarstellung.offsetX}
                fit={coverDarstellung.fit}
              />}
        </div>
      )}

      <div class="post__content">
        {lead && leadImContent && <p class="post__inline-lead">{lead}</p>}
        <div class="prose"><Content /></div>

      </div>

      <a class="post__back" href="/aktuelles">
        <span aria-hidden="true">←</span> Alle Beiträge
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: clamp(1.25rem, 2.5vw, 2rem) clamp(3rem, 7vw, 6rem);
  }

  .post__head {
    margin-top: 0;
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--hairline-strong);
  }

  .post__back {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.4ch;
    font-weight: 700;
    color: var(--blue-700);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline-strong);
  }

  .post__title-block time {
    font-size: var(--step--1);
    font-weight: 800;
    color: var(--blue-700);
  }

  .post__title-block h1 {
    max-width: 20ch;
    margin-top: var(--space-2);
    font-size: var(--step-4);
    color: var(--blue-700);
    overflow-wrap: normal;
  }

  .post__cover {
    width: 100%;
    margin-top: clamp(1.5rem, 4vw, 3rem);
  }

  .post__lead {
    max-width: none;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 380;
    line-height: var(--leading-normal);
    color: var(--text-muted);
    text-align: justify;
    hyphens: auto;
  }

  .post__cover :global(img) {
    max-height: 36rem;
  }

  .post__content {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .post__content :global(.prose) {
    max-width: none;
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 380;
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .post__inline-lead {
    margin-bottom: var(--space-5);
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 380;
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  /*
    Steht die Einleitung im Textbereich statt über dem Bild, rückt der
    Textbereich etwas nach unten (Feld `leadImContent`).
  */
  .post.has-lead-im-content .post__content {
    padding-top: var(--space-2);
  }

  .post__cover,
  .post__content {
    margin-top: var(--space-2);
  }

  /*
    Ab 760px stehen Bild und Text nebeneinander. Diese Regeln galten früher
    nur für die fünf damals vorhandenen Beiträge (`.post--<slug>`), sodass
    jeder NEUE Beitrag auf ein abweichendes Float-Layout zurückfiel. Jetzt
    gelten sie für alle – die bestehenden Beiträge sehen unverändert aus.
  */
  @media (min-width: 760px) {
    .post__inner {
      display: grid;
      grid-template-columns: minmax(16rem, 28rem) minmax(0, 1fr);
      column-gap: clamp(1.5rem, 4vw, 3rem);
    }

    .post__head,
    .post__lead,
    .post__back {
      grid-column: 1 / -1;
    }

    .post__cover {
      grid-column: 1;
      width: 100%;
    }

    .post__content {
      grid-column: 2;
    }
  }

  .post__back,
  .post__gallery {
    clear: both;
  }

  .post__inner::after {
    display: block;
    clear: both;
    content: '';
  }

  .post__gallery {
    margin-top: var(--section-space);
    padding-top: var(--space-6);
    border-top: 1px solid var(--hairline-strong);
  }

  .post__gallery h2 {
    font-size: var(--step-2);
  }

  .post__gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
</style>
