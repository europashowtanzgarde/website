# Cloudflare Pages – HTTP-Header
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # Die Seite lädt nichts von fremden Servern (Schriften sind selbst gehostet,
  # kein Tracking, keine CDNs) – genau das sperrt 'self' ab.
  #
  # 'unsafe-inline' ist bei Skripten UND Stilen nötig, weil Astro beides direkt
  # in die Seite schreibt: kleine Stylesheets und das Menü-Skript im Kopfbereich.
  # Ohne die Freigabe bliebe das Menü auf dem Handy stumm. Feste Prüfsummen
  # wären die strengere Lösung, ändern sich aber bei jedem Bau – in einer
  # statischen Header-Datei ist das nicht zu pflegen.
  # Der Schutz vor eingeschleustem Skriptcode kommt hier ohnehin aus einer
  # anderen Richtung: Markdown-Inhalte werden beim Bauen gefiltert
  # (rehype-sanitize in astro.config.mjs).
  #
  # 'data:' bei Schriften und Bildern: Eine Schrift ist in tokens.css eingebettet,
  # die Platzhalter-Grafiken sind Inline-SVG.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# Der Redaktionsbereich gehört nicht in Suchmaschinen.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store


# Von Astro gehashte Assets dürfen dauerhaft gecacht werden.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Redaktionell hochgeladene Bilder moderat cachen.
/uploads/*
  Cache-Control: public, max-age=86400
